---
import Icon from './Icon.astro';
import { url } from '@/data/curriculum';

interface Props {
  /** Show the drawer button even on wide screens (pages with a sidebar use it below 1100px). */
  hasSidebar?: boolean;
}
const { hasSidebar = false } = Astro.props;

const nav = [
  { href: '/book/', label: '책' },
  { href: '/playground/', label: '실험실' },
  { href: '/practice/', label: '코드랩' },
  { href: '/review/', label: '복습' },
  { href: '/glossary/', label: '용어 사전' },
  { href: '/map/', label: '학습 지도' }
] as const;

const path = Astro.url.pathname;
const isActive = (href: string) => path.startsWith(url(href));
---
<header class="site-header" data-pagefind-ignore>
  <div class="header-inner">
    <button class="btn btn-ghost btn-icon drawer-btn" type="button" aria-label="메뉴 열기" aria-controls="drawer" aria-expanded="false" data-drawer-open data-has-sidebar={hasSidebar ? '' : undefined}>
      <Icon name="menu" size={20} />
    </button>

    <a class="logo" href={url('/')} aria-label="AIology 홈">
      <span class="logo-ai">AI</span>ology
    </a>

    <nav class="main-nav" aria-label="주요 메뉴">
      {nav.map((item) => (
        <a href={url(item.href)} class:list={['nav-link', { active: isActive(item.href) }]} aria-current={isActive(item.href) ? 'page' : undefined}>
          {item.label}
        </a>
      ))}
    </nav>

    <div class="header-actions">
      <button class="search-btn" type="button" data-search-open aria-label="검색 (Ctrl+K)">
        <Icon name="search" size={16} />
        <span class="search-label">검색</span>
        <kbd class="search-kbd">⌘K</kbd>
      </button>
      <button class="btn btn-ghost btn-icon theme-btn" type="button" data-theme-toggle aria-label="밝은 화면과 어두운 화면 전환">
        <span class="theme-icon theme-sun"><Icon name="sun" size={18} /></span>
        <span class="theme-icon theme-moon"><Icon name="moon" size={18} /></span>
      </button>
      <a class="btn btn-ghost btn-icon gh-btn" href="https://github.com/llouis0622/AI" target="_blank" rel="noopener noreferrer" aria-label="GitHub 저장소">
        <Icon name="github" size={18} />
      </a>
    </div>
  </div>
  <div class="reading-progress" aria-hidden="true"><span></span></div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    height: var(--header-h);
    background: color-mix(in srgb, var(--bg) 86%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border);
  }

  .header-inner {
    display: flex;
    align-items: center;
    gap: 12px;
    height: 100%;
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 var(--gutter);
  }

  .logo {
    font-weight: 700;
    font-size: 19px;
    letter-spacing: -0.03em;
    flex: none;
  }

  .logo-ai {
    color: var(--accent);
  }

  .main-nav {
    display: flex;
    align-items: center;
    gap: 2px;
    margin-left: 22px;
  }

  .nav-link {
    position: relative;
    padding: 6px 12px;
    border-radius: var(--radius-sm);
    color: var(--text-2);
    font-size: 14.5px;
    font-weight: 550;
    line-height: 22px;
    transition: color 0.15s, background-color 0.15s;
  }

  .nav-link:hover {
    color: var(--text);
    background: var(--surface-2);
  }

  .nav-link.active {
    color: var(--text);
  }

  .nav-link.active::after {
    content: '';
    position: absolute;
    left: 12px;
    right: 12px;
    /* sits on the header's bottom border: (59px content - 34px link) / 2 */
    bottom: -12px;
    height: 2px;
    background: var(--accent);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 2px;
    margin-left: auto;
  }

  .search-btn {
    display: flex;
    align-items: center;
    gap: 8px;
    height: 36px;
    margin-right: 4px;
    padding: 0 8px 0 12px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--text-3);
    font-size: 13.5px;
    font-weight: 500;
    min-width: 200px;
    transition: border-color 0.15s, color 0.15s;
  }

  .search-btn:hover {
    border-color: var(--border-strong);
    color: var(--text-2);
  }

  .search-kbd {
    margin-left: auto;
    padding: 0 6px;
    border-radius: 4px;
    border: 1px solid var(--border);
    font-family: var(--font-sans);
    font-size: 11.5px;
    color: var(--text-3);
  }

  .theme-icon {
    display: grid;
    place-items: center;
  }

  :global(:root[data-theme='light']) .theme-sun,
  :global(:root:not([data-theme='light'])) .theme-moon {
    display: none;
  }

  .drawer-btn {
    display: none;
  }

  .reading-progress {
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 2px;
    pointer-events: none;
  }

  .reading-progress span {
    display: block;
    height: 100%;
    width: 100%;
    transform-origin: left;
    transform: scaleX(var(--read, 0));
    background: var(--accent);
  }

  @media (max-width: 1180px) {
    .search-label,
    .search-kbd {
      display: none;
    }
    .search-btn {
      min-width: 0;
      width: 36px;
      justify-content: center;
      padding: 0;
    }
    .main-nav {
      margin-left: 10px;
    }
    .nav-link {
      padding: 6px 9px;
    }
  }

  @media (max-width: 960px) {
    .main-nav {
      display: none;
    }
    .drawer-btn {
      display: inline-flex;
    }
    .gh-btn {
      display: none;
    }
  }
</style>
