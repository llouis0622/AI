---
import { getCollection } from 'astro:content';
import { PARTS, TRACKS, url } from '@/data/curriculum';

interface Props {
  section: 'book' | 'practice' | 'review';
  /** Current entry id (slug). */
  current?: string;
}
const { section, current } = Astro.props;

const book = section === 'book' ? (await getCollection('book')).sort((a, b) => a.data.chapter - b.data.chapter) : [];
const labs = section === 'practice' ? (await getCollection('practice')).sort((a, b) => a.data.lab - b.data.lab) : [];
const quizzes = section === 'review' ? (await getCollection('review')).sort((a, b) => a.data.part - b.data.part) : [];

const bookHref = (id: string) => url(id === '00-intro' ? '/book/' : `/book/${id}/`);
const labHref = (id: string) => url(id === '00-overview' ? '/practice/' : `/practice/${id}/`);
const quizHref = (id: string) => url(id === 'index' ? '/review/' : `/review/${id}/`);
const currentPart = book.find((e) => e.id === current)?.data.part ?? 1;
---
<nav class="sidebar" aria-label={section === 'book' ? '책 목차' : section === 'practice' ? '코드랩 목록' : '복습 퀴즈 목록'} data-pagefind-ignore>
  {section === 'book' && (
    <>
      <a href={bookHref('00-intro')} class:list={['side-link', 'side-intro', { current: current === '00-intro' }]}>
        <span class="side-num">📖</span><span>여는 글 — 이 책을 읽는 법</span>
      </a>
      {PARTS.map((p) => (
        <details class="side-part" data-part={p.part} open={p.part === currentPart}>
          <summary>
            <span class="side-part-emoji">{p.emoji}</span>
            <span class="side-part-title"><small>{p.part}부</small>{p.title}</span>
          </summary>
          <ul>
            {book.filter((e) => e.data.part === p.part).map((e) => (
              <li>
                <a href={bookHref(e.id)} class:list={['side-link', { current: current === e.id }]} data-ch={e.data.chapter} aria-current={current === e.id ? 'page' : undefined}>
                  <span class="side-num">{e.data.chapter}</span>
                  <span class="side-title">{e.data.title}</span>
                  <span class="side-dot" aria-hidden="true"></span>
                </a>
              </li>
            ))}
          </ul>
        </details>
      ))}
      <a href={url('/review/')} class="side-link side-intro"><span class="side-num">✅</span><span>복습 퀴즈</span></a>
    </>
  )}

  {section === 'practice' && (
    <>
      <a href={labHref('00-overview')} class:list={['side-link', 'side-intro', { current: current === '00-overview' }]}>
        <span class="side-num">🧰</span><span>코드랩 개요 · 환경 준비</span>
      </a>
      {TRACKS.map((t) => (
        <details class="side-part" open>
          <summary>
            <span class="side-part-emoji">{t.emoji}</span>
            <span class="side-part-title">{t.title}</span>
          </summary>
          <ul>
            {labs.filter((e) => t.labs.includes(e.data.lab)).map((e) => (
              <li>
                <a href={labHref(e.id)} class:list={['side-link', { current: current === e.id }]} data-lab={e.data.lab} aria-current={current === e.id ? 'page' : undefined}>
                  <span class="side-num">{String(e.data.lab).padStart(2, '0')}</span>
                  <span class="side-title">{e.data.title}</span>
                  <span class="side-dot" aria-hidden="true"></span>
                </a>
              </li>
            ))}
          </ul>
        </details>
      ))}
    </>
  )}

  {section === 'review' && (
    <ul class="side-flat">
      {quizzes.map((e) => (
        <li data-part={e.data.part}>
          <a href={quizHref(e.id)} class:list={['side-link', { current: current === e.id }]} aria-current={current === e.id ? 'page' : undefined}>
            <span class="side-num">{e.data.part === 0 ? '🏠' : `${e.data.part}부`}</span>
            <span class="side-title">{e.data.part === 0 ? '복습 허브' : e.data.title}</span>
          </a>
        </li>
      ))}
    </ul>
  )}
</nav>

<script>
  import { loadProgress, onProgress } from '@/lib/progress';
  function paint() {
    const p = loadProgress();
    document.querySelectorAll<HTMLElement>('.sidebar [data-ch]').forEach((a) => {
      const m = p.chapters[a.dataset.ch!];
      a.classList.toggle('is-visited', !!m?.visited);
      a.classList.toggle('is-done', !!m?.done);
    });
    document.querySelectorAll<HTMLElement>('.sidebar [data-lab]').forEach((a) => {
      const m = p.labs[a.dataset.lab!];
      a.classList.toggle('is-visited', !!m?.visited);
      a.classList.toggle('is-done', !!m?.done);
    });
  }
  paint();
  onProgress(paint);
  document.querySelector('.doc-sidebar .side-link.current')?.scrollIntoView({ block: 'center' });
</script>

<style is:global>
  .sidebar {
    display: flex;
    flex-direction: column;
    gap: 4px;
    font-size: 14.5px;
  }

  .sidebar ul {
    list-style: none;
    margin: 0;
    padding: 2px 0 8px;
  }

  .side-link {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 10px;
    border-radius: 12px;
    color: var(--text-2);
    line-height: 1.4;
    transition: background-color 0.18s, color 0.18s;
  }

  .side-link:hover {
    background: var(--surface-2);
    color: var(--text);
  }

  .side-link.current {
    background: var(--brand-soft);
    color: var(--text);
    font-weight: 700;
  }

  :root[data-theme='dark'] .side-link.current {
    box-shadow: inset 0 0 0 1px rgba(34, 229, 255, 0.25);
  }

  .side-num {
    display: inline-grid;
    place-items: center;
    min-width: 26px;
    height: 26px;
    padding: 0 4px;
    border-radius: 8px;
    background: var(--surface-3);
    color: var(--text-2);
    font-size: 12px;
    font-weight: 800;
    flex: none;
  }

  .side-link.current .side-num {
    background: var(--grad-brand);
    color: #fff;
  }

  :root[data-theme='dark'] .side-link.current .side-num {
    color: #041018;
  }

  .side-title {
    flex: 1;
    min-width: 0;
  }

  .side-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    border: 1.5px solid var(--border-strong);
    flex: none;
  }

  .side-link.is-visited .side-dot {
    border-color: var(--brand);
    background: color-mix(in srgb, var(--brand) 35%, transparent);
  }

  .side-link.is-done .side-dot {
    border-color: var(--ok);
    background: var(--ok);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--ok) 22%, transparent);
  }

  .side-intro {
    font-weight: 650;
  }

  .side-part {
    border-radius: 14px;
  }

  .side-part > summary {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 10px;
    border-radius: 12px;
    cursor: pointer;
    list-style: none;
    font-weight: 750;
    color: var(--text);
  }

  .side-part > summary::-webkit-details-marker {
    display: none;
  }

  .side-part > summary:hover {
    background: var(--surface-2);
  }

  .side-part > summary::after {
    content: '▸';
    margin-left: auto;
    color: var(--text-3);
    transition: transform 0.2s;
  }

  .side-part[open] > summary::after {
    transform: rotate(90deg);
  }

  .side-part-emoji {
    display: inline-grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 10px;
    background: var(--part-soft, var(--surface-3));
    font-size: 16px;
    flex: none;
  }

  .side-part-title {
    display: flex;
    flex-direction: column;
    line-height: 1.3;
    font-size: 14.5px;
  }

  .side-part-title small {
    font-size: 11.5px;
    color: var(--text-3);
    font-weight: 700;
  }

  .side-part ul {
    margin-left: 14px;
    padding-left: 10px;
    border-left: 2px solid var(--border);
  }

  .side-flat li .side-num {
    min-width: 34px;
  }
</style>
