---
import { getCollection } from 'astro:content';
import { PARTS, TRACKS, url } from '@/data/curriculum';
import Icon from './Icon.astro';

interface Props {
  section: 'book' | 'practice' | 'review';
  /** Current entry id (slug). */
  current?: string;
}
const { section, current } = Astro.props;

const book = section === 'book' ? (await getCollection('book')).sort((a, b) => a.data.chapter - b.data.chapter) : [];
const labs = section === 'practice' ? (await getCollection('practice')).sort((a, b) => a.data.lab - b.data.lab) : [];
const quizzes = section === 'review' ? (await getCollection('review')).sort((a, b) => a.data.part - b.data.part) : [];

const bookHref = (id: string) => url(id === '00-intro' ? '/book/' : `/book/${id}/`);
const labHref = (id: string) => url(id === '00-overview' ? '/practice/' : `/practice/${id}/`);
const quizHref = (id: string) => url(id === 'index' ? '/review/' : `/review/${id}/`);
const currentPart = book.find((e) => e.id === current)?.data.part ?? 1;
---
<nav class="sidebar" aria-label={section === 'book' ? '책 목차' : section === 'practice' ? '코드랩 목록' : '복습 퀴즈 목록'} data-pagefind-ignore>
  {section === 'book' && (
    <>
      <a href={bookHref('00-intro')} class:list={['side-link', 'side-intro', { current: current === '00-intro' }]}>
        <span class="side-num"><Icon name="book" size={15} /></span><span>여는 글</span>
      </a>
      {PARTS.map((p) => (
        <details class="side-part" data-part={p.part} open={p.part === currentPart}>
          <summary>
            <span class="side-part-no">{p.part}부</span>
            <span class="side-part-title">{p.title}</span>
            <Icon name="chevron-right" size={15} class="side-chev" />
          </summary>
          <ul>
            {book.filter((e) => e.data.part === p.part).map((e) => (
              <li>
                <a href={bookHref(e.id)} class:list={['side-link', { current: current === e.id }]} data-ch={e.data.chapter} aria-current={current === e.id ? 'page' : undefined}>
                  <span class="side-num">{e.data.chapter}</span>
                  <span class="side-title">{e.data.title}</span>
                  <span class="side-dot" aria-hidden="true"></span>
                </a>
              </li>
            ))}
          </ul>
        </details>
      ))}
      <a href={url('/review/')} class="side-link side-intro"><span class="side-num"><Icon name="check-square" size={15} /></span><span>복습 퀴즈</span></a>
    </>
  )}

  {section === 'practice' && (
    <>
      <a href={labHref('00-overview')} class:list={['side-link', 'side-intro', { current: current === '00-overview' }]}>
        <span class="side-num"><Icon name="code" size={15} /></span><span>개요와 환경 준비</span>
      </a>
      {TRACKS.map((t) => (
        <details class="side-part" open>
          <summary>
            <span class="side-part-title">{t.title}</span>
            <Icon name="chevron-right" size={15} class="side-chev" />
          </summary>
          <ul>
            {labs.filter((e) => t.labs.includes(e.data.lab)).map((e) => (
              <li>
                <a href={labHref(e.id)} class:list={['side-link', { current: current === e.id }]} data-lab={e.data.lab} aria-current={current === e.id ? 'page' : undefined}>
                  <span class="side-num">{String(e.data.lab).padStart(2, '0')}</span>
                  <span class="side-title">{e.data.title}</span>
                  <span class="side-dot" aria-hidden="true"></span>
                </a>
              </li>
            ))}
          </ul>
        </details>
      ))}
    </>
  )}

  {section === 'review' && (
    <ul class="side-flat">
      {quizzes.map((e) => (
        <li data-part={e.data.part}>
          <a href={quizHref(e.id)} class:list={['side-link', { current: current === e.id }]} aria-current={current === e.id ? 'page' : undefined}>
            <span class="side-num">{e.data.part === 0 ? <Icon name="list" size={15} /> : `${e.data.part}부`}</span>
            <span class="side-title">{e.data.part === 0 ? '복습 안내' : e.data.title}</span>
          </a>
        </li>
      ))}
    </ul>
  )}
</nav>

<script>
  import { loadProgress, onProgress } from '@/lib/progress';
  function paint() {
    const p = loadProgress();
    document.querySelectorAll<HTMLElement>('.sidebar [data-ch]').forEach((a) => {
      const m = p.chapters[a.dataset.ch!];
      a.classList.toggle('is-visited', !!m?.visited);
      a.classList.toggle('is-done', !!m?.done);
    });
    document.querySelectorAll<HTMLElement>('.sidebar [data-lab]').forEach((a) => {
      const m = p.labs[a.dataset.lab!];
      a.classList.toggle('is-visited', !!m?.visited);
      a.classList.toggle('is-done', !!m?.done);
    });
  }
  paint();
  onProgress(paint);
  const current = document.querySelector<HTMLElement>('.doc-sidebar .side-link.current');
  const box = current?.closest<HTMLElement>('.doc-sticky');
  if (current && box) box.scrollTop = current.offsetTop - box.clientHeight / 2;
</script>

<style is:global>
  .sidebar {
    display: flex;
    flex-direction: column;
    gap: 2px;
    font-size: 14px;
  }

  .sidebar ul {
    list-style: none;
    margin: 0;
    padding: 2px 0 10px;
  }

  .side-link {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 6px 10px;
    border-radius: var(--radius-xs);
    color: var(--text-2);
    line-height: 1.45;
    transition: background-color 0.15s, color 0.15s;
  }

  .side-link:hover {
    background: var(--surface-2);
    color: var(--text);
  }

  .side-link.current {
    background: var(--surface-2);
    color: var(--text);
    font-weight: 600;
  }

  .side-num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 22px;
    color: var(--text-3);
    font-size: 12px;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    flex: none;
  }

  .side-link.current .side-num {
    color: var(--accent);
  }

  .side-title {
    flex: 1;
    min-width: 0;
  }

  .side-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    border: 1px solid var(--border-strong);
    flex: none;
  }

  .side-link.is-visited .side-dot {
    border-color: var(--accent);
  }

  .side-link.is-done .side-dot {
    border-color: var(--accent);
    background: var(--accent);
  }

  .side-intro {
    font-weight: 550;
  }

  .side-part > summary {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 8px 10px;
    border-radius: var(--radius-xs);
    cursor: pointer;
    list-style: none;
    font-weight: 600;
    color: var(--text);
  }

  .side-part > summary::-webkit-details-marker {
    display: none;
  }

  .side-part > summary:hover {
    background: var(--surface-2);
  }

  .side-part .side-chev {
    margin-left: auto;
    color: var(--text-3);
    transition: transform 0.2s;
  }

  .side-part[open] .side-chev {
    transform: rotate(90deg);
  }

  .side-part-no {
    color: var(--text-3);
    font-size: 12px;
    font-weight: 600;
    min-width: 22px;
  }

  .side-part-title {
    font-size: 14px;
  }

  .side-part ul {
    margin-left: 20px;
    padding-left: 8px;
    border-left: 1px solid var(--border);
  }

  .side-flat li .side-num {
    min-width: 30px;
  }
</style>
