---
/** Static stroke icon for Astro pages; same set as the React visualizations. */
import IconSvg, { type IconName } from '@/components/ui/Icon';

interface Props {
  name: IconName;
  size?: number;
  strokeWidth?: number;
  class?: string;
  title?: string;
}

const { name, size = 18, strokeWidth, class: className, title } = Astro.props;
---
<IconSvg name={name} size={size} strokeWidth={strokeWidth} className={className} title={title} />
