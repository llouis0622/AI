---
import Icon from '@/components/layout/Icon.astro';
import { url } from '@/data/curriculum';

interface Props {
  kind: 'chapter' | 'lab';
  num: number;
  /** Optional links shown next to the button. */
  links?: { href: string; label: string }[];
}
const { kind, num, links = [] } = Astro.props;
const what = kind === 'chapter' ? '이 장' : '이 코드랩';
---
<section class="complete" data-complete={kind} data-num={num} data-pagefind-ignore>
  <div class="complete-body">
    <p class="complete-title">
      <span class="t-idle">{what}을 끝냈다면 완료로 표시해 두세요.</span>
      <span class="t-done">{what}을 완료로 표시했어요.</span>
    </p>
    <p class="complete-text">
      진도는 <a href={url('/map/')}>학습 지도</a>에 기록되고, 이 브라우저에만 저장됩니다.
    </p>
  </div>
  <div class="complete-actions">
    <button class="btn btn-primary complete-btn" type="button" data-complete-btn>
      <Icon name="check" size={16} />
      <span class="t-idle">완료로 표시</span>
      <span class="t-done" title="다시 누르면 취소돼요">완료됨</span>
    </button>
    {links.map((l) => <a class="btn" href={l.href}>{l.label}</a>)}
  </div>
</section>

<script>
  import { loadProgress, onProgress, setChapterDone, setLabDone, markChapterVisited, markLabVisited } from '@/lib/progress';

  document.querySelectorAll<HTMLElement>('[data-complete]').forEach((card) => {
    const kind = card.dataset.complete as 'chapter' | 'lab';
    const num = Number(card.dataset.num);
    const btn = card.querySelector<HTMLButtonElement>('[data-complete-btn]')!;
    const isDone = () => {
      const p = loadProgress();
      return !!(kind === 'chapter' ? p.chapters[num]?.done : p.labs[num]?.done);
    };
    const paint = () => {
      const done = isDone();
      card.classList.toggle('is-done', done);
      btn.setAttribute('aria-pressed', String(done));
    };
    if (kind === 'chapter') markChapterVisited(num);
    else markLabVisited(num);
    paint();
    onProgress(paint);
    btn.addEventListener('click', () => {
      const next = !isDone();
      if (kind === 'chapter') setChapterDone(num, next);
      else setLabDone(num, next);
    });
  });
</script>

<style>
  .complete {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px 24px;
    margin: 48px 0 20px;
    padding: 18px 20px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
  }

  .complete-title {
    margin: 0 0 2px;
    font-size: 15.5px;
    font-weight: 650;
  }

  .complete-text {
    margin: 0;
    color: var(--text-3);
    font-size: 13.5px;
  }

  .complete-text a {
    color: var(--text-2);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .complete-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .t-done {
    display: none;
  }

  .complete.is-done .t-idle {
    display: none;
  }

  .complete.is-done .t-done {
    display: inline;
  }

  .complete.is-done .complete-btn {
    background: var(--surface);
    border-color: var(--accent);
    color: var(--accent);
  }
</style>
