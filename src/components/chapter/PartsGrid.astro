---
import { PARTS } from '@/data/curriculum';
import { bookHref, type BookEntry } from '@/lib/content';

interface Props {
  book: BookEntry[];
  heading?: string;
}
const { book, heading } = Astro.props;
---
<section class="parts" aria-label={heading ?? '9부 구성'}>
  {heading && <h2 class="parts-heading">{heading}</h2>}
  <div class="parts-grid">
    {PARTS.map((p) => {
      const chapters = book.filter((e) => e.data.part === p.part);
      return (
        <article class="part-card card card-hover" id={`part-${p.part}`} data-part={p.part} data-reveal>
          <div class="part-top">
            <span class="part-no">{p.part}부</span>
            <h3 class="part-title">{p.title}</h3>
          </div>
          <p class="part-blurb">{p.blurb}</p>
          <ol class="part-chapters">
            {chapters.map((e) => (
              <li>
                <a href={bookHref(e.id)} data-ch={e.data.chapter}>
                  <span class="pc-num">{e.data.chapter}</span>
                  <span class="pc-title">{e.data.title}</span>
                  <span class="pc-dot" aria-hidden="true"></span>
                </a>
              </li>
            ))}
          </ol>
        </article>
      );
    })}
  </div>
</section>

<script>
  import { loadProgress, onProgress } from '@/lib/progress';
  const paint = () => {
    const p = loadProgress();
    document.querySelectorAll<HTMLElement>('.part-chapters [data-ch]').forEach((a) => {
      const m = p.chapters[a.dataset.ch!];
      a.classList.toggle('is-visited', !!m?.visited);
      a.classList.toggle('is-done', !!m?.done);
    });
  };
  paint();
  onProgress(paint);
</script>

<style>
  .parts {
    margin: 8px 0 44px;
  }

  .parts-heading {
    margin: 0 0 16px;
    font-size: 19px;
    font-weight: 650;
    letter-spacing: -0.02em;
  }

  .parts-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 12px;
  }

  .part-card {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 18px 18px 12px;
    scroll-margin-top: calc(var(--header-h) + 20px);
  }

  .part-card:hover {
    background: var(--surface);
  }

  .part-no {
    display: block;
    color: var(--accent);
    font-size: 12.5px;
    font-weight: 600;
  }

  .part-title {
    margin: 2px 0 0;
    font-size: 16.5px;
    font-weight: 650;
    letter-spacing: -0.015em;
  }

  .part-blurb {
    margin: 0;
    color: var(--text-2);
    font-size: 13.5px;
    line-height: 1.65;
  }

  .part-chapters {
    margin: 6px 0 0;
    padding: 6px 0 0;
    list-style: none;
    border-top: 1px solid var(--border);
  }

  .part-chapters a {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 5px 0;
    color: var(--text-2);
    font-size: 14px;
    transition: color 0.15s;
  }

  .part-chapters a:hover {
    color: var(--text);
  }

  .pc-num {
    min-width: 20px;
    color: var(--text-3);
    font-size: 12px;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  .pc-title {
    flex: 1;
    min-width: 0;
  }

  .pc-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    border: 1px solid var(--border-strong);
    flex: none;
  }

  .is-visited .pc-dot {
    border-color: var(--accent);
  }

  .is-done .pc-dot {
    border-color: var(--accent);
    background: var(--accent);
  }
</style>
