---
import Icon from '@/components/layout/Icon.astro';
import { partOf, url } from '@/data/curriculum';
import { glossaryTerms } from '@/data/glossary';

interface Props {
  chapter: number;
  title: string;
  question?: string;
  prereq?: string;
  /** Legacy mascot line; ignored. */
  mascot?: string;
  minutes: number;
  vizCount: number;
  /** id of the first visualization on the page (chip links to it). */
  firstViz?: string;
  /** chapter number -> entry id, for linking "N장" mentions in the prereq line. */
  slugs: Record<number, string>;
}
const { chapter, title, question, prereq, minutes, vizCount, firstViz, slugs } = Astro.props;
const part = partOf(chapter);
const newTerms = glossaryTerms.filter((t) => t.chapter === chapter);

const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
const bold = (s: string) => esc(s).replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>');
const prereqHtml = prereq
  ? esc(prereq)
      .replace(/\[([^\]]+)\]\((\/[^)]+)\)/g, (_, t, href) => `<a href="${url(href.endsWith('/') ? href : `${href}/`)}">${t}</a>`)
      .replace(/(\d+)(~\d+)?장/g, (m, n) => (slugs[Number(n)] ? `<a href="${url(`/book/${slugs[Number(n)]}/`)}">${m}</a>` : m))
  : '';
---
<header class="ch-hero">
  <div class="ch-eyebrow">
    {part && <a href={url(`/book/#part-${part.part}`)}>{part.part}부 · {part.title}</a>}
    {part && <span class="ch-sep" aria-hidden="true">/</span>}
    <span>{chapter === 0 ? '여는 글' : `${chapter}장`}</span>
  </div>

  <h1 class="ch-title">{title}</h1>

  {question && (
    <div class="ch-question">
      <span class="ch-q-label">이 장의 질문</span>
      <p set:html={bold(question)} />
    </div>
  )}

  <div class="ch-meta">
    <span class="ch-meta-item"><Icon name="clock" size={15} />약 {minutes}분</span>
    {vizCount > 0 && (
      <a class="ch-meta-item" href={firstViz ? `#viz-${firstViz}` : undefined}><Icon name="flask" size={15} />시각화 {vizCount}개</a>
    )}
  </div>

  {newTerms.length > 0 && (
    <div class="ch-terms" data-pagefind-ignore>
      <span class="ch-terms-label">이 장에서 처음 나오는 용어</span>
      <div class="ch-terms-list">
        {newTerms.map((t) => (
          <span
            class="term ch-term"
            tabindex="0"
            role="button"
            data-term={t.id}
            data-title={t.term}
            data-def={t.short}
            data-href={url(`/glossary/#${t.id}`)}
          >
            {t.term}
          </span>
        ))}
      </div>
    </div>
  )}

  {prereq && (
    <p class="ch-prereq">
      <span class="ch-prereq-label">먼저 읽으면 좋아요</span>
      <span set:html={prereqHtml} />
    </p>
  )}
</header>

<style>
  .ch-hero {
    margin-bottom: 36px;
    padding-bottom: 28px;
    border-bottom: 1px solid var(--border);
  }

  .ch-eyebrow {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    margin-bottom: 14px;
    color: var(--text-3);
    font-size: 13.5px;
    font-weight: 550;
  }

  .ch-eyebrow a:hover {
    color: var(--text);
  }

  .ch-sep {
    color: var(--border-strong);
  }

  .ch-title {
    margin: 0 0 22px;
    font-size: clamp(30px, 4.4vw, 40px);
    font-weight: 700;
    line-height: 1.25;
    letter-spacing: -0.035em;
  }

  .ch-question {
    margin: 0 0 22px;
    padding-left: 16px;
    border-left: 2px solid var(--accent);
  }

  .ch-q-label {
    display: block;
    margin-bottom: 4px;
    color: var(--accent);
    font-size: 12.5px;
    font-weight: 600;
  }

  .ch-question p {
    margin: 0;
    color: var(--text-2);
    font-size: 17px;
    line-height: 1.75;
  }

  .ch-question :global(strong) {
    color: var(--text);
    font-weight: 650;
  }

  .ch-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 18px;
    margin-bottom: 20px;
    color: var(--text-3);
    font-size: 13.5px;
  }

  .ch-meta-item {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  a.ch-meta-item:hover {
    color: var(--text);
  }

  .ch-terms {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin: 0 0 16px;
  }

  .ch-terms-label {
    color: var(--text-3);
    font-size: 12.5px;
    font-weight: 600;
  }

  .ch-terms-list {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .ch-term {
    display: inline-flex;
    align-items: center;
    padding: 3px 10px;
    border-radius: var(--radius-xs);
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--text-2);
    font-size: 13px;
    font-weight: 550;
    cursor: help;
    transition: border-color 0.15s, color 0.15s;
  }

  .ch-term:hover,
  .ch-term:focus-visible,
  .ch-term[aria-expanded='true'] {
    border-color: var(--accent);
    color: var(--text);
  }

  .ch-prereq {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 10px;
    align-items: baseline;
    margin: 0;
    font-size: 14px;
    color: var(--text-2);
    line-height: 1.7;
  }

  .ch-prereq-label {
    color: var(--text-3);
    font-size: 12.5px;
    font-weight: 600;
    flex: none;
  }

  .ch-prereq :global(a) {
    color: var(--accent);
  }

  .ch-prereq :global(a:hover) {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
