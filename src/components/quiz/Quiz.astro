---
/**
 * Active-recall card. The answer (slot) stays hidden until "정답 보기".
 * Marks are saved as `aihub-quiz:<id>` = pass | again (kept compatible with the old site).
 */
interface Props {
  id: string;
  q: string;
}
const { id, q } = Astro.props;
const num = Number(id.split('-').pop());
---
<section class="quiz" data-quiz={id}>
  <div class="quiz-q">
    <span class="quiz-num" aria-hidden="true">Q{Number.isFinite(num) ? num : ''}</span>
    <p class="quiz-text">{q}</p>
    <span class="quiz-status" aria-live="polite" data-pagefind-ignore></span>
  </div>
  <button class="quiz-reveal" type="button" data-quiz-reveal aria-expanded="false" data-pagefind-ignore>답을 떠올린 뒤 정답 보기</button>
  <div class="quiz-answer" hidden>
    <div class="quiz-a"><slot /></div>
    <div class="quiz-actions" data-pagefind-ignore>
      <button class="quiz-btn quiz-pass" type="button" data-quiz-mark="pass">맞혔어요</button>
      <button class="quiz-btn quiz-again" type="button" data-quiz-mark="again">다시 볼게요</button>
      <button class="quiz-btn" type="button" data-quiz-hide>답 숨기기</button>
    </div>
  </div>
</section>

<script>
  const KEY = (id: string) => `aihub-quiz:${id}`;
  const read = (id: string) => {
    try {
      return localStorage.getItem(KEY(id));
    } catch {
      return null;
    }
  };
  const paint = (el: HTMLElement) => {
    const v = read(el.dataset.quiz!);
    el.classList.toggle('is-pass', v === 'pass');
    el.classList.toggle('is-again', v === 'again');
    el.querySelector('.quiz-status')!.textContent = v === 'pass' ? '맞힘' : v === 'again' ? '다시 보기' : '';
  };
  document.querySelectorAll<HTMLElement>('[data-quiz]').forEach((el) => {
    paint(el);
    const answer = el.querySelector<HTMLElement>('.quiz-answer')!;
    const reveal = el.querySelector<HTMLButtonElement>('[data-quiz-reveal]')!;
    reveal.addEventListener('click', () => {
      answer.hidden = false;
      reveal.hidden = true;
      reveal.setAttribute('aria-expanded', 'true');
    });
    el.querySelector('[data-quiz-hide]')!.addEventListener('click', () => {
      answer.hidden = true;
      reveal.hidden = false;
      reveal.setAttribute('aria-expanded', 'false');
      reveal.focus();
    });
    el.querySelectorAll<HTMLButtonElement>('[data-quiz-mark]').forEach((b) =>
      b.addEventListener('click', () => {
        try {
          localStorage.setItem(KEY(el.dataset.quiz!), b.dataset.quizMark!);
        } catch {
          /* storage unavailable */
        }
        paint(el);
        window.dispatchEvent(new CustomEvent('aihub-quiz-change'));
      })
    );
  });
</script>

<style is:global>
  .quiz {
    margin: 14px 0;
    padding: 16px 18px;
    border-radius: var(--radius);
    background: var(--surface);
    border: 1px solid var(--border);
    transition: border-color 0.2s;
  }

  .quiz.is-pass {
    border-color: color-mix(in srgb, var(--ok) 45%, var(--border));
  }

  .quiz.is-again {
    border-color: color-mix(in srgb, var(--warn) 45%, var(--border));
  }

  .quiz-q {
    display: flex;
    align-items: flex-start;
    gap: 12px;
  }

  .quiz-num {
    min-width: 30px;
    padding-top: 3px;
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 500;
    flex: none;
  }

  .quiz-text {
    flex: 1;
    margin: 0 !important;
    font-weight: 600;
    font-size: 16px;
    line-height: 1.65;
  }

  .quiz-status {
    flex: none;
    margin-top: 3px;
    font-size: 12.5px;
    font-weight: 600;
    color: var(--text-3);
  }

  .quiz.is-pass .quiz-status { color: var(--ok); }
  .quiz.is-again .quiz-status { color: var(--warn); }

  .quiz-reveal {
    margin: 12px 0 0 42px;
    padding: 6px 12px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border-strong);
    font-size: 13.5px;
    font-weight: 550;
    color: var(--text-2);
    transition: border-color 0.15s, color 0.15s;
  }

  .quiz-reveal:hover {
    border-color: var(--text-3);
    color: var(--text);
  }

  .quiz-answer {
    margin-left: 42px;
  }

  .quiz-a {
    margin-top: 12px;
    padding: 2px 0 2px 14px;
    border-left: 2px solid var(--accent);
    font-size: 15.5px;
  }

  .quiz-a > :first-child { margin-top: 0; }
  .quiz-a > :last-child { margin-bottom: 0; }

  .quiz-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 12px;
  }

  .quiz-btn {
    padding: 5px 12px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border-strong);
    background: var(--surface);
    font-size: 13px;
    font-weight: 550;
    color: var(--text-2);
    transition: border-color 0.15s, color 0.15s;
  }

  .quiz-pass:hover { border-color: var(--ok); color: var(--ok); }
  .quiz-again:hover { border-color: var(--warn); color: var(--warn); }

  @media (max-width: 640px) {
    .quiz-reveal,
    .quiz-answer {
      margin-left: 0;
    }
  }
</style>
