---
/**
 * "한눈에 보기": the chapter's story in a few numbered steps, from the
 * frontmatter `summary:` list. Static HTML, no script.
 */
interface Card {
  title: string;
  text: string;
}
interface Props {
  cards: Card[];
  heading?: string;
}
const { cards, heading = '한눈에 보기' } = Astro.props;
const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
const rich = (s: string) => esc(s).replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>');
// Older frontmatter numbered titles itself ("① …"); the list numbers them now.
const plainTitle = (s: string) => s.replace(/^[①-⑳]\s*/, '');
---
{cards.length > 0 && (
  <section class="vsum" aria-label={heading}>
    <p class="vsum-label">{heading}</p>
    <ol class="vsum-list">
      {cards.map((c, i) => (
        <li class="vsum-item">
          <span class="vsum-no" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <div class="vsum-body">
            <h3 class="vsum-title" set:html={rich(plainTitle(c.title))} />
            <p class="vsum-text" set:html={rich(c.text)} />
          </div>
        </li>
      ))}
    </ol>
  </section>
)}

<style>
  .vsum {
    margin: 0 0 40px;
    padding: 20px 22px 6px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
  }

  .vsum-label {
    margin: 0 0 6px;
    color: var(--text-3);
    font-size: 12.5px;
    font-weight: 600;
  }

  .vsum-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: 28px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .vsum-item {
    display: flex;
    gap: 14px;
    padding: 14px 0;
    border-top: 1px solid var(--border);
  }

  .vsum-item:nth-child(-n + 2) {
    border-top: 0;
  }

  .vsum-no {
    flex: none;
    min-width: 22px;
    padding-top: 2px;
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 12.5px;
    font-weight: 500;
  }

  .vsum-body {
    min-width: 0;
  }

  .vsum-title {
    margin: 0 0 4px;
    font-size: 15.5px;
    font-weight: 650;
    line-height: 1.45;
    letter-spacing: -0.015em;
  }

  .vsum-text {
    margin: 0;
    color: var(--text-2);
    font-size: 14.5px;
    line-height: 1.7;
  }

  .vsum-text :global(strong),
  .vsum-title :global(strong) {
    color: var(--text);
    font-weight: 650;
  }

  @media (max-width: 720px) {
    .vsum {
      padding: 16px 18px 4px;
    }
    .vsum-list {
      grid-template-columns: minmax(0, 1fr);
    }
    .vsum-item:nth-child(2) {
      border-top: 1px solid var(--border);
    }
  }
</style>
