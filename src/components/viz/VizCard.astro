---
/**
 * Gallery card for a visualization. Uses the captured thumbnails in
 * public/thumbs/{light,dark}/<id>.jpg when present (see scripts/make-thumbs.mjs),
 * otherwise a plain grid placeholder.
 */
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import type { VizMeta } from '@/data/viz';
import { url, partOf } from '@/data/curriculum';
import Icon from '@/components/layout/Icon.astro';

interface Props {
  meta: VizMeta;
  /** Small label above the title, e.g. "2장" or "코드랩 03". */
  label: string;
  reveal?: boolean;
}
const { meta, label, reveal = false } = Astro.props;
const thumb = (theme: string) => join(process.cwd(), 'public', 'thumbs', theme, `${meta.id}.jpg`);
const hasThumb = existsSync(thumb('light')) && existsSync(thumb('dark'));
const part = meta.chapter !== undefined ? partOf(meta.chapter)?.part : 7;
---
<a
  class="vcard card card-hover"
  href={url(`/playground/${meta.id}/`)}
  data-viz-card={meta.id}
  data-3d={meta.is3D ? '1' : '0'}
  data-kind={meta.lab !== undefined ? 'lab' : 'book'}
  data-part={part}
  data-reveal={reveal ? '' : undefined}
>
  <span class:list={['vcard-art', { 'has-thumb': hasThumb }]}>
    {hasThumb ? (
      <>
        <img class="vcard-img vcard-img-light" src={url(`/thumbs/light/${meta.id}.jpg`)} alt="" loading="lazy" decoding="async" width="480" height="298" />
        <img class="vcard-img vcard-img-dark" src={url(`/thumbs/dark/${meta.id}.jpg`)} alt="" loading="lazy" decoding="async" width="480" height="298" />
      </>
    ) : (
      <span class="vcard-placeholder" aria-hidden="true"><Icon name={meta.is3D ? 'cube' : 'chart-line'} size={28} strokeWidth={1.25} /></span>
    )}
    {meta.is3D && <span class="vz-badge vcard-3d">3D</span>}
    <span class="vcard-done"><Icon name="check" size={13} />해 봤어요</span>
  </span>
  <span class="vcard-body">
    <span class="vcard-label">{label}</span>
    <strong class="vcard-title">{meta.title}</strong>
    <span class="vcard-tag">{meta.tagline}</span>
  </span>
</a>

<style is:global>
  .vcard {
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .vcard[hidden] {
    display: none;
  }

  .vcard-art {
    position: relative;
    display: grid;
    place-items: center;
    aspect-ratio: 480 / 298;
    border-bottom: 1px solid var(--border);
    background: var(--viz-bg);
    overflow: hidden;
  }

  .vcard-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    transition: opacity 0.2s;
  }

  .vcard:hover .vcard-img {
    opacity: 0.92;
  }

  :root[data-theme='light'] .vcard-img-dark,
  :root:not([data-theme='light']) .vcard-img-light {
    display: none;
  }

  .vcard-placeholder {
    color: var(--text-3);
  }

  .vcard-3d {
    position: absolute;
    top: 10px;
    right: 10px;
    background: color-mix(in srgb, var(--surface) 90%, transparent);
  }

  .vcard-done {
    position: absolute;
    left: 10px;
    top: 10px;
    display: none;
    align-items: center;
    gap: 4px;
    padding: 1px 7px 1px 5px;
    border-radius: 4px;
    background: color-mix(in srgb, var(--surface) 92%, transparent);
    border: 1px solid var(--border);
    color: var(--accent);
    font-size: 11.5px;
    font-weight: 600;
  }

  .vcard.is-done .vcard-done {
    display: inline-flex;
  }

  .vcard-body {
    display: flex;
    flex-direction: column;
    gap: 3px;
    padding: 14px 16px 16px;
  }

  .vcard-label {
    color: var(--text-3);
    font-size: 12.5px;
    font-weight: 550;
  }

  .vcard-title {
    font-size: 15.5px;
    font-weight: 650;
    letter-spacing: -0.015em;
    line-height: 1.45;
  }

  .vcard-tag {
    color: var(--text-2);
    font-size: 13.5px;
    line-height: 1.6;
  }
</style>
