---
import { render } from 'astro:content';
import DocLayout from '@/layouts/DocLayout.astro';
import PrevNext from '@/components/chapter/PrevNext.astro';
import EditLinks from '@/components/chapter/EditLinks.astro';
import { getQuizzes, quizHref, type QuizEntry } from '@/lib/content';
import { PARTS } from '@/data/curriculum';

export async function getStaticPaths() {
  const quizzes = await getQuizzes();
  return quizzes.map((entry, i) => ({
    params: { slug: entry.id === 'index' ? undefined : entry.id },
    props: { entry, prev: quizzes[i - 1], next: quizzes[i + 1] }
  }));
}

interface Props {
  entry: QuizEntry;
  prev?: QuizEntry;
  next?: QuizEntry;
}
const { entry, prev, next } = Astro.props;
const { Content, headings } = await render(entry);
const d = entry.data;
const isHub = d.part === 0;
const part = PARTS.find((p) => p.part === d.part);
const quizzes = await getQuizzes();
const link = (e?: QuizEntry) => e && { href: quizHref(e.id), label: e.data.part === 0 ? '복습 안내' : `${e.data.part}부 퀴즈`, title: e.data.part === 0 ? '복습 퀴즈' : e.data.title };
const pageTitle = isHub ? '복습 퀴즈' : `${d.part}부 퀴즈. ${d.title}`;
---
<DocLayout title={pageTitle} section="review" current={entry.id} headings={headings} ogType="website">
  <article class="quiz-page" data-part={d.part} data-pagefind-body data-pagefind-meta={`title:${isHub ? '복습 퀴즈' : `${d.part}부 퀴즈 · ${d.title}`}`}>
    <header class="qp-head">
      <span class="qp-eyebrow">{part ? `${part.part}부 복습` : '복습'}</span>
      <h1 class="qp-title">{isHub ? '복습 퀴즈' : d.title}</h1>
      <p class="qp-lead">
        {isHub
          ? '답을 보기 전에 먼저 머릿속으로 답해 보세요. 떠올려 보는 과정이 기억을 오래 남깁니다.'
          : `문제 ${d.total}개입니다. 먼저 스스로 답해 본 뒤 정답을 확인하고, 맞혔는지 표시해 두세요.`}
      </p>
    </header>

    {isHub && (
      <div class="qp-grid">
        {quizzes.filter((q) => q.data.part > 0).map((q) => {
          const p = PARTS.find((x) => x.part === q.data.part)!;
          return (
            <a class="qp-card card card-hover" href={quizHref(q.id)} data-part={q.data.part} data-quiz-prefix={`p${q.data.part}`} data-total={q.data.total}>
              <span class="qp-card-body">
                <small>{p.part}부 · {q.data.total}문제</small>
                <strong>{q.data.title}</strong>
                <span class="qp-bar"><span></span></span>
                <span class="qp-stat">아직 기록이 없어요</span>
              </span>
            </a>
          );
        })}
      </div>
    )}

    <div class="prose">
      <Content />
    </div>

    <PrevNext prev={link(prev)} next={link(next)} />
    <EditLinks path={entry.filePath} title={pageTitle} />
  </article>
</DocLayout>

<script>
  document.querySelectorAll<HTMLElement>('[data-quiz-prefix]').forEach((card) => {
    const prefix = card.dataset.quizPrefix!;
    const total = Number(card.dataset.total);
    let pass = 0;
    let again = 0;
    try {
      for (let i = 0; i < localStorage.length; i++) {
        const k = localStorage.key(i);
        if (k?.startsWith(`aihub-quiz:${prefix}-`)) {
          const v = localStorage.getItem(k);
          if (v === 'pass') pass++;
          else if (v === 'again') again++;
        }
      }
    } catch {
      /* storage unavailable */
    }
    const bar = card.querySelector<HTMLElement>('.qp-bar span')!;
    bar.style.width = `${total ? Math.round((pass / total) * 100) : 0}%`;
    if (pass || again) card.querySelector('.qp-stat')!.textContent = `맞힘 ${pass} / ${total}${again ? ` · 복습 ${again}` : ''}`;
  });
</script>

<style>
  .qp-head {
    margin-bottom: 32px;
    padding-bottom: 24px;
    border-bottom: 1px solid var(--border);
  }

  .qp-eyebrow {
    display: block;
    margin-bottom: 12px;
    color: var(--text-3);
    font-size: 13.5px;
    font-weight: 550;
  }

  .qp-title {
    margin: 0 0 12px;
    font-size: clamp(28px, 4.2vw, 38px);
    font-weight: 700;
    letter-spacing: -0.035em;
    line-height: 1.25;
  }

  .qp-lead {
    margin: 0;
    color: var(--text-2);
    font-size: 16.5px;
    line-height: 1.75;
  }

  .qp-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
    gap: 12px;
    margin-bottom: 36px;
  }

  .qp-card {
    display: flex;
    padding: 16px;
  }

  .qp-card-body {
    display: flex;
    flex-direction: column;
    gap: 3px;
    flex: 1;
    min-width: 0;
  }

  .qp-card-body small {
    color: var(--text-3);
    font-size: 12.5px;
    font-weight: 550;
  }

  .qp-card-body strong {
    font-weight: 650;
  }

  .qp-bar {
    display: block;
    height: 4px;
    margin-top: 8px;
    border-radius: 99px;
    background: var(--surface-3);
    overflow: hidden;
  }

  .qp-bar span {
    display: block;
    height: 100%;
    width: 0;
    background: var(--accent);
    transition: width 0.5s var(--ease-out);
  }

  .qp-stat {
    margin-top: 2px;
    font-size: 12.5px;
    color: var(--text-3);
  }
</style>
