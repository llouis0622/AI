---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Icon from '@/components/layout/Icon.astro';
import { glossaryTerms } from '@/data/glossary';
import { PARTS, partOf } from '@/data/curriculum';
import { getBook, bookHref } from '@/lib/content';

const book = await getBook();
const slugOf = (ch: number) => book.find((e) => e.data.chapter === ch)?.id;
const byPart = PARTS.map((p) => ({
  part: p,
  terms: glossaryTerms.filter((t) => partOf(t.chapter)?.part === p.part).sort((a, b) => a.chapter - b.chapter || a.term.localeCompare(b.term, 'ko'))
})).filter((g) => g.terms.length);
---
<BaseLayout title="용어 사전" description="AI를 공부하다 막히는 용어를 쉬운 말로 풀어 둔 사전입니다.">
  <main id="main" class="container gl-page">
    <header class="gl-hero">
      <span class="eyebrow">용어 {glossaryTerms.length}개</span>
      <h1 class="gl-title">용어 사전</h1>
      <p>본문에서 <span class="gl-sample">점선 밑줄</span>이 그어진 용어를 누르면 여기 있는 설명이 바로 뜹니다. 용어는 처음 나오는 부 순서대로 모았어요.</p>
      <label class="gl-search">
        <Icon name="search" size={16} />
        <input type="search" placeholder="용어 찾기 (예: 기울기, 어텐션)" data-gl-search autocomplete="off" />
      </label>
      <nav class="gl-jump" aria-label="부별 바로가기">
        {byPart.map(({ part }) => <a href={`#gl-part-${part.part}`}>{part.part}부</a>)}
      </nav>
    </header>

    <div data-pagefind-body data-pagefind-meta="title:용어 사전">
      {byPart.map(({ part, terms }) => (
        <section class="gl-group" id={`gl-part-${part.part}`}>
          <h2 class="gl-group-title"><span class="gl-group-no">{part.part}부</span>{part.title}</h2>
          <div class="gl-list">
            {terms.map((t) => {
              const slug = slugOf(t.chapter);
              return (
                <article class="gl-item" data-gl-term={`${t.term} ${(t.aliases ?? []).join(' ')} ${t.short}`.toLowerCase()}>
                  <div class="gl-item-head">
                    <h3 id={t.id}>{t.term}</h3>
                    {t.aliases && t.aliases.length > 0 && <span class="gl-alias">{t.aliases.join(', ')}</span>}
                  </div>
                  <div class="gl-item-body">
                    <p class="gl-short">{t.short}</p>
                    {t.long && <p class="gl-long">{t.long}</p>}
                    {slug && <a class="gl-from" data-pagefind-ignore href={bookHref(slug)}>{t.chapter}장에서 처음 나와요</a>}
                  </div>
                </article>
              );
            })}
          </div>
        </section>
      ))}
    </div>
    <p class="gl-empty" hidden data-gl-empty>찾는 용어가 없어요.</p>
  </main>
</BaseLayout>

<script>
  const input = document.querySelector<HTMLInputElement>('[data-gl-search]')!;
  const cards = [...document.querySelectorAll<HTMLElement>('[data-gl-term]')];
  const empty = document.querySelector<HTMLElement>('[data-gl-empty]')!;
  input.addEventListener('input', () => {
    const q = input.value.trim().toLowerCase();
    let shown = 0;
    cards.forEach((c) => {
      const ok = !q || c.dataset.glTerm!.includes(q);
      c.hidden = !ok;
      if (ok) shown++;
    });
    document.querySelectorAll<HTMLElement>('.gl-group').forEach((g) => {
      g.hidden = ![...g.querySelectorAll<HTMLElement>('[data-gl-term]')].some((c) => !c.hidden);
    });
    empty.hidden = shown > 0;
  });
  // Highlight the term targeted by #hash (coming from a tooltip link)
  const target = location.hash && document.getElementById(decodeURIComponent(location.hash.slice(1)));
  if (target) target.closest('.gl-item')?.classList.add('is-target');
</script>

<style>
  .gl-page {
    padding-top: 40px;
    max-width: 1000px;
  }

  .gl-hero {
    padding-bottom: 24px;
    border-bottom: 1px solid var(--border);
  }

  .gl-title {
    margin: 0 0 10px;
    font-size: clamp(28px, 4vw, 38px);
    font-weight: 700;
    letter-spacing: -0.035em;
  }

  .gl-hero p {
    margin: 0;
    max-width: 40em;
    color: var(--text-2);
  }

  .gl-sample {
    border-bottom: 1px dashed var(--text-3);
  }

  .gl-search {
    display: flex;
    align-items: center;
    gap: 10px;
    max-width: 420px;
    margin-top: 22px;
    padding: 0 12px;
    height: 40px;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-sm);
    background: var(--surface);
    color: var(--text-3);
  }

  .gl-search:focus-within {
    border-color: var(--accent);
  }

  .gl-search input {
    flex: 1;
    min-width: 0;
    border: 0;
    outline: none;
    background: transparent;
    font-size: 15px;
    color: var(--text);
  }

  .gl-jump {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 14px;
    margin-top: 16px;
    font-size: 13.5px;
  }

  .gl-jump a {
    color: var(--text-3);
  }

  .gl-jump a:hover {
    color: var(--text);
  }

  .gl-group {
    margin-top: 44px;
    scroll-margin-top: calc(var(--header-h) + 20px);
  }

  .gl-group-title {
    display: flex;
    align-items: baseline;
    gap: 10px;
    margin: 0 0 8px;
    font-size: 18px;
    font-weight: 650;
    letter-spacing: -0.02em;
  }

  .gl-group-no {
    color: var(--accent);
    font-size: 13px;
    font-weight: 600;
  }

  .gl-list {
    border-top: 1px solid var(--border);
  }

  .gl-item {
    display: grid;
    grid-template-columns: 200px minmax(0, 1fr);
    gap: 8px 24px;
    padding: 16px 0;
    border-bottom: 1px solid var(--border);
    transition: background-color 0.3s;
  }

  .gl-item.is-target {
    background: var(--accent-soft);
  }

  .gl-item[hidden] {
    display: none;
  }

  .gl-item-head h3 {
    margin: 0;
    font-size: 16px;
    font-weight: 650;
    scroll-margin-top: calc(var(--header-h) + 24px);
  }

  .gl-alias {
    display: block;
    margin-top: 2px;
    color: var(--text-3);
    font-size: 13px;
  }

  .gl-short {
    margin: 0;
    font-size: 15px;
    line-height: 1.7;
  }

  .gl-long {
    margin: 6px 0 0;
    color: var(--text-2);
    font-size: 14.5px;
    line-height: 1.7;
  }

  .gl-from {
    display: inline-block;
    margin-top: 6px;
    color: var(--accent);
    font-size: 13px;
  }

  .gl-from:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .gl-empty {
    margin: 32px 0;
    color: var(--text-3);
    text-align: center;
  }

  @media (max-width: 680px) {
    .gl-item {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
