---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Viz from '@/components/viz/Viz.tsx';
import Icon from '@/components/layout/Icon.astro';
import { allViz, type VizMeta } from '@/data/viz';
import { getBook, getLabs, bookHref, labHref } from '@/lib/content';
import { url, partOf } from '@/data/curriculum';

export function getStaticPaths() {
  return allViz.map((v, i) => ({ params: { id: v.id }, props: { meta: v, prev: allViz[i - 1], next: allViz[i + 1] } }));
}

interface Props {
  meta: VizMeta;
  prev?: VizMeta;
  next?: VizMeta;
}
const { meta, prev, next } = Astro.props;
const book = await getBook();
const labs = await getLabs();
const chapter = meta.chapter !== undefined ? book.find((e) => e.data.chapter === meta.chapter) : undefined;
const lab = meta.lab !== undefined ? labs.find((e) => e.data.lab === meta.lab) : undefined;
const home = chapter
  ? { href: `${bookHref(chapter.id)}#viz-${meta.id}`, label: `${chapter.data.chapter}장 「${chapter.data.title}」` }
  : lab
    ? { href: `${labHref(lab.id)}#viz-${meta.id}`, label: `코드랩 ${String(lab.data.lab).padStart(2, '0')} 「${lab.data.title}」` }
    : undefined;
const part = meta.chapter !== undefined ? partOf(meta.chapter) : undefined;
---
<BaseLayout title={`${meta.title} · 시각화 실험실`} description={meta.tagline}>
  <main id="main" class="container pg-single">
    <nav class="crumbs" aria-label="경로">
      <a href={url('/playground/')}>시각화 실험실</a>
      <Icon name="chevron-right" size={14} class="crumb-sep" />
      <span>{meta.title}</span>
    </nav>

    <Viz id={meta.id} client:load />

    {home && (
      <a class="pg-home card card-hover" href={home.href}>
        <span class="pg-home-text">
          <small>{part ? `${part.part}부 · ${part.title}` : '코드랩'}</small>
          <strong>{home.label}에서 이어서 읽기</strong>
        </span>
        <Icon name="arrow-right" size={18} />
      </a>
    )}

    <nav class="pg-pn" aria-label="다른 시각화">
      {prev ? <a class="pg-link" href={url(`/playground/${prev.id}/`)}><Icon name="arrow-left" size={15} /><span>{prev.title}</span></a> : <span />}
      {next ? <a class="pg-link pg-next" href={url(`/playground/${next.id}/`)}><span>{next.title}</span><Icon name="arrow-right" size={15} /></a> : <span />}
    </nav>
  </main>
</BaseLayout>

<style>
  .pg-single {
    max-width: 1080px;
    padding-top: 28px;
  }

  .crumbs {
    display: flex;
    align-items: center;
    gap: 6px;
    color: var(--text-3);
    font-size: 13.5px;
  }

  .crumbs a:hover {
    color: var(--text);
  }

  .crumbs :global(.crumb-sep) {
    color: var(--border-strong);
  }

  .pg-home {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 14px 18px;
    color: var(--text-2);
  }

  .pg-home-text {
    display: flex;
    flex-direction: column;
    flex: 1;
    min-width: 0;
  }

  .pg-home small {
    color: var(--text-3);
    font-size: 12.5px;
  }

  .pg-home strong {
    color: var(--text);
    font-weight: 600;
  }

  .pg-pn {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 24px;
  }

  .pg-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    max-width: 48%;
    color: var(--text-2);
    font-size: 14px;
    transition: color 0.15s;
  }

  .pg-link:hover {
    color: var(--text);
  }

  .pg-link span {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
</style>
