{
  "name": "aiology",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "AIology — 그림과 3D로 보면서 배우는 인공지능 교과서",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && pagefind --site dist",
    "preview": "astro preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check:viz": "node scripts/check-viz-refs.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.5",
    "@astrojs/mdx": "^8.1.2",
    "@astrojs/react": "^7.1.2",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "astro": "^7.4.4",
    "katex": "^0.19.1",
    "pretendard": "^1.3.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "pagefind": "^1.5.2",
    "typescript": "^6.0.3"
  }
}
